{
  "name": "simple-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "sync-plugins": "node scripts/sync-plugin-catalog.mjs",
    "regenerate:skill-websites": "node scripts/regenerate-skill-websites.mjs",
    "generate:playbooks": "node scripts/generate-plugin-playbooks.mjs",
    "validate:playbooks": "node scripts/validate-playbooks.mjs",
    "generate:og": "tsx scripts/generate-og-images.ts",
    "generate:og:home": "tsx scripts/generate-og-images.ts --home",
    "build": "npm run sync:demo-assets && npm run validate:playbooks && npm run generate:og:home -- --force && next build",
    "start": "next start",
    "lint": "next lint",
    "generate:og:core": "tsx scripts/generate-og-images.ts --kinds=home,hub,page,team,feature,use-case,industry,alternative,channel,loop,compare,showcase,legacy-integration",
    "sync:demo-assets": "rm -rf public/demo && mkdir -p public/demo && cp -r packages/demo/assets/* public/demo/",
    "characters:export": "node scripts/export-cast-svgs.mjs",
    "characters:build": "cd vendor/bible-strong-avatar-lab && ./node_modules/.bin/vite build --base /character-studio/ --outDir ../../public/character-studio"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@headlessui/react": "^1.7.17",
    "@sendgrid/mail": "^8.1.3",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "aos": "^3.0.0-beta.6",
    "border-beam": "^1.3.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.9",
    "html-escaper": "^3.0.3",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "mermaid": "^11.15.0",
    "next": "^14.0.4",
    "next-plausible": "^3.12.0",
    "nodemailer": "^6.9.13",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "^0.1.1",
    "typescript": "^5.3.3",
    "@bible-strong/avatar-core": "file:vendor/bible-strong-avatar-lab/packages/avatar-core",
    "@bible-strong/avatar-react": "file:vendor/bible-strong-avatar-lab/packages/avatar-react"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/aos": "^3.0.7",
    "@types/canvas-confetti": "^1.6.4",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.22.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
